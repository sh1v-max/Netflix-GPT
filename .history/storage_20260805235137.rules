rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Custom avatars — one file per user, only that user can write it.
    // Read is public since avatar URLs get embedded in <img> tags across
    // the app (nav, dropdown, profile) without an auth header.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
