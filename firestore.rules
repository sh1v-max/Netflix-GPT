rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user can only ever read/write their own subtree —
    // ratings, watchlist, and computed taste profile all live under
    // users/{uid}/..., and this rule covers all of it via wildcard match.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
